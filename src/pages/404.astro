---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, t, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const homeHref = getRelativeLocaleUrl(locale, '/');
const projectsHref = getRelativeLocaleUrl(locale, '/projects');
const aboutHref = getRelativeLocaleUrl(locale, '/about');
---

<BaseLayout title={t(locale, '404.title')} description={t(locale, '404.description')}>
  <Header />

  <main class="min-h-[calc(100vh-8rem)] flex items-center">
    <Container size="sm">
      <div class="relative text-center py-20">
        {/* Error code */}
        <h1 class="font-display text-[10rem] md:text-[14rem] lg:text-[18rem] font-extrabold leading-none text-[var(--accent)] mb-8">
          404
        </h1>

        {/* Error message */}
        <div class="space-y-4 mb-12">
          <p class="font-body text-sm uppercase text-[var(--text)]">
            {t(locale, '404.badge')}
          </p>

          <h2 class="font-display text-3xl md:text-4xl font-bold uppercase text-[var(--text)]">
            {t(locale, '404.heading')}
          </h2>

          <p class="max-w-md mx-auto">
            {t(locale, '404.message')}
          </p>
        </div>

        {/* Terminal-style error details */}
        <pre class="inline-block text-left p-6 mb-12 max-w-md mx-auto w-full border-2" style="border-color: var(--text);">
          <code>
            <span style="color: var(--accent);">$</span> GET /unknown-path<br />
            <span class="text-[var(--accent)]">Error:</span> ENOENT: no such file or directory<br />
            <span class="text-[var(--text)]">at</span> FileSystem.lookup (/universe/matrix)<br />
            <span style="color: var(--accent);">status:</span> 404<br />
            <span style="color: var(--accent);">suggestion:</span> navigate_home()<br />
            <span class="text-[var(--accent)];">$</span> <span class="cursor-blink text-[var(--text)]">_</span>
          </code>
        </pre>

        {/* Action buttons */}
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href={homeHref} class="btn btn-primary magnetic">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 mr-2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
              />
            </svg>
            {t(locale, '404.backHome')}
          </a>
          <a href={projectsHref} class="btn magnetic">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 mr-2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"
              />
            </svg>
            {t(locale, '404.browseProjects')}
          </a>
        </div>

        {/* Quick links */}
        <div class="flex flex-wrap justify-center gap-6">
          <a
            href={homeHref}
            class="text-sm font-body uppercase text-[var(--text)]"
          >
            {t(locale, '404.quickHome')}
          </a>
          <a
            href={projectsHref}
            class="text-sm font-body uppercase text-[var(--text)]"
          >
            {t(locale, '404.quickProjects')}
          </a>
          <a
            href={aboutHref}
            class="text-sm font-body uppercase text-[var(--text)]"
          >
            {t(locale, '404.quickAbout')}
          </a>
        </div>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Cursor blink */
  .cursor-blink {
    animation: cursor 1s step-end infinite;
  }

  @keyframes cursor {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

