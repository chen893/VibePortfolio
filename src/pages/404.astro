---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, t, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const homeHref = getRelativeLocaleUrl(locale, '/');
const projectsHref = getRelativeLocaleUrl(locale, '/projects');
const aboutHref = getRelativeLocaleUrl(locale, '/about');
---

<BaseLayout title={t(locale, '404.title')} description={t(locale, '404.description')}>
  <Header />

  <main class="min-h-[calc(100vh-8rem)] flex items-center relative overflow-hidden" style="background: #050505;">
    {/* Background effects */}
    <div class="absolute inset-0 pointer-events-none">
      {/* Animated scan line */}
      <div class="scanline-effect" />

      {/* Grid */}
      <div
        class="absolute inset-0 opacity-[0.03]"
        style="background-image: linear-gradient(#00f0ff 1px, transparent 1px), linear-gradient(90deg, #00f0ff 1px, transparent 1px); background-size: 40px 40px;"
      />

      {/* Gradient orbs */}
      <div
        class="absolute top-1/4 left-1/4 w-[400px] h-[400px] animate-float"
        style="background: radial-gradient(circle, rgba(0,240,255,0.1) 0%, transparent 70%); filter: blur(60px);"
      />
      <div
        class="absolute bottom-1/4 right-1/4 w-[300px] h-[300px] animate-float-delayed"
        style="background: radial-gradient(circle, rgba(255,45,146,0.08) 0%, transparent 70%); filter: blur(60px);"
      />
    </div>

    {/* Corner decorations */}
    <div class="absolute top-8 left-8 w-16 h-16 border-l-2 border-t-2" style="border-color: rgba(0, 240, 255, 0.3);" />
    <div class="absolute top-8 right-8 w-16 h-16 border-r-2 border-t-2" style="border-color: rgba(0, 240, 255, 0.3);" />
    <div class="absolute bottom-8 left-8 w-16 h-16 border-l-2 border-b-2" style="border-color: rgba(255, 45, 146, 0.3);" />
    <div class="absolute bottom-8 right-8 w-16 h-16 border-r-2 border-b-2" style="border-color: rgba(255, 45, 146, 0.3);" />

    <Container size="sm">
      <div class="relative text-center py-20">
        {/* Glitch 404 */}
        <div class="relative mb-8">
          <h1
            class="glitch-text text-[10rem] md:text-[14rem] lg:text-[18rem] font-bold leading-none select-none"
            style="font-family: 'Clash Display', sans-serif;"
            data-text="404"
          >
            <span class="glitch-layer" aria-hidden="true">404</span>
            <span class="glitch-layer" aria-hidden="true">404</span>
            404
          </h1>

          {/* Decorative brackets */}
          <div
            class="absolute top-1/2 left-0 -translate-y-1/2 text-6xl md:text-8xl font-light hidden md:block"
            style="color: rgba(0, 240, 255, 0.2); font-family: 'Space Mono', monospace;"
          >
            {'<'}
          </div>
          <div
            class="absolute top-1/2 right-0 -translate-y-1/2 text-6xl md:text-8xl font-light hidden md:block"
            style="color: rgba(255, 45, 146, 0.2); font-family: 'Space Mono', monospace;"
          >
            {'/>'}
          </div>
        </div>

        {/* Error message */}
        <div class="space-y-4 mb-12">
          <div
            class="inline-flex items-center gap-2 px-4 py-2"
            style="border: 1px solid #ff2d92; font-family: 'Space Mono', monospace;"
          >
            <span class="w-2 h-2 rounded-full animate-pulse" style="background: #ff2d92; box-shadow: 0 0 10px #ff2d92;" />
            <span class="text-xs tracking-wider" style="color: #ff2d92;">
              {t(locale, '404.badge')}
            </span>
          </div>

          <h2
            class="text-2xl md:text-3xl font-bold"
            style="font-family: 'Clash Display', sans-serif; color: #fafafa;"
          >
            {t(locale, '404.heading')}
          </h2>

          <p
            class="max-w-md mx-auto"
            style="color: #737373; font-family: 'Space Grotesk', sans-serif;"
          >
            {t(locale, '404.message')}
          </p>
        </div>

        {/* Terminal-style error details */}
        <div
          class="inline-block text-left p-6 mb-12 max-w-md mx-auto w-full"
          style="background: #0d0d0d; border: 1px solid #262626; font-family: 'Space Mono', monospace; font-size: 0.75rem;"
        >
          <div class="flex items-center gap-2 mb-4 pb-2" style="border-bottom: 1px solid #262626;">
            <span class="w-3 h-3 rounded-full" style="background: #ff5f57;" />
            <span class="w-3 h-3 rounded-full" style="background: #febc2e;" />
            <span class="w-3 h-3 rounded-full" style="background: #28c840;" />
            <span class="ml-4" style="color: #525252;">terminal</span>
          </div>
          <div style="color: #525252;">
            <div><span style="color: #00f0ff;">$</span> GET /unknown-path</div>
            <div class="mt-2" style="color: #ff2d92;">
              Error: ENOENT: no such file or directory
            </div>
            <div class="mt-1" style="color: #737373;">
              at FileSystem.lookup (/universe/matrix)
            </div>
            <div class="mt-2">
              <span style="color: #e4ff1a;">status:</span> 404
            </div>
            <div>
              <span style="color: #e4ff1a;">suggestion:</span> navigate_home()
            </div>
            <div class="mt-4 flex items-center gap-2">
              <span style="color: #00f0ff;">$</span>
              <span class="cursor-blink" style="color: #fafafa;">_</span>
            </div>
          </div>
        </div>

        {/* Action buttons */}
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href={homeHref} class="btn-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-5 h-5 mr-2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
              />
            </svg>
            {t(locale, '404.backHome')}
          </a>
          <a href={projectsHref} class="btn-secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-5 h-5 mr-2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"
              />
            </svg>
            {t(locale, '404.browseProjects')}
          </a>
        </div>

        {/* Quick links */}
        <div class="flex flex-wrap justify-center gap-6" style="font-family: 'Space Mono', monospace;">
          <a
            href={homeHref}
            class="group flex items-center gap-2 text-sm transition-all duration-300"
            style="color: #525252;"
          >
            <span style="color: #00f0ff;">01</span>
            <span class="group-hover:text-[#00f0ff] transition-colors">{t(locale, '404.quickHome')}</span>
          </a>
          <a
            href={projectsHref}
            class="group flex items-center gap-2 text-sm transition-all duration-300"
            style="color: #525252;"
          >
            <span style="color: #ff2d92;">02</span>
            <span class="group-hover:text-[#ff2d92] transition-colors">{t(locale, '404.quickProjects')}</span>
          </a>
          <a
            href={aboutHref}
            class="group flex items-center gap-2 text-sm transition-all duration-300"
            style="color: #525252;"
          >
            <span style="color: #e4ff1a;">03</span>
            <span class="group-hover:text-[#e4ff1a] transition-colors">{t(locale, '404.quickAbout')}</span>
          </a>
        </div>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Glitch effect */
  .glitch-text {
    position: relative;
    color: transparent;
    background: linear-gradient(135deg, #00f0ff 0%, #ff2d92 50%, #e4ff1a 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .glitch-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #00f0ff 0%, #ff2d92 50%, #e4ff1a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .glitch-layer:first-child {
    animation: glitch-1 2.5s infinite linear alternate-reverse;
    clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
  }

  .glitch-layer:nth-child(2) {
    animation: glitch-2 2.5s infinite linear alternate-reverse;
    clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
  }

  @keyframes glitch-1 {
    0%, 100% {
      transform: translate(0);
    }
    20% {
      transform: translate(-3px, 3px);
    }
    40% {
      transform: translate(-3px, -3px);
    }
    60% {
      transform: translate(3px, 3px);
    }
    80% {
      transform: translate(3px, -3px);
    }
  }

  @keyframes glitch-2 {
    0%, 100% {
      transform: translate(0);
    }
    20% {
      transform: translate(3px, -3px);
    }
    40% {
      transform: translate(3px, 3px);
    }
    60% {
      transform: translate(-3px, -3px);
    }
    80% {
      transform: translate(-3px, 3px);
    }
  }

  /* Scan line effect */
  .scanline-effect {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(transparent, rgba(0, 240, 255, 0.1), transparent);
    animation: scanline 4s linear infinite;
    pointer-events: none;
  }

  @keyframes scanline {
    0% {
      top: -4px;
    }
    100% {
      top: 100%;
    }
  }

  /* Float animations */
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 6s ease-in-out infinite;
    animation-delay: -3s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  /* Cursor blink */
  .cursor-blink {
    animation: cursor 1s step-end infinite;
  }

  @keyframes cursor {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
