---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/layout/Container.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { defaultLocale, t, type Locale } from '../../i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

// 获取所有项目
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => {
  // 精选项目优先
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  // 按 order 排序
  return a.data.order - b.data.order;
});

// 提取所有唯一的技术栈
const allTechnologies = [
  ...new Set(allProjects.flatMap((p) => p.data.technologies)),
].sort();

// 分类标签映射
const categoryLabels: Record<string, { label: string }> = {
  web: { label: t(locale, 'category.web.short') },
  mobile: { label: t(locale, 'category.mobile.short') },
  backend: { label: t(locale, 'category.backend.short') },
  fullstack: { label: t(locale, 'category.fullstack.short') },
  tool: { label: t(locale, 'category.tool.short') },
  other: { label: t(locale, 'category.other.short') },
};

// 获取所有分类
const allCategories = [...new Set(allProjects.map((p) => p.data.category))];
---

<BaseLayout title={t(locale, 'projects.title')} description={t(locale, 'projects.metaDescription')}>
  <Header />

  <main class="min-h-screen">
    <Container>
      {/* Page Header */}
      <div class="pt-32 pb-16">
        {/* Label */}
        <div class="flex items-center gap-4 mb-6">
          <span class="text-sm font-body uppercase text-[var(--text)]">
            {t(locale, 'projects.label')}
          </span>
          <div class="flex-1 h-px bg-[var(--border)]" />
        </div>

        {/* Title */}
        <h1 class="font-display text-5xl font-extrabold uppercase mb-6">
          {t(locale, 'projects.titleA')}
          <br />
          <span class="text-[var(--accent)]">{t(locale, 'projects.titleB')}</span>
        </h1>

        <p class="max-w-2xl text-lg">
          {t(locale, 'projects.description')}
        </p>
      </div>

      {/* Filters Section */}
      <div class="mb-12 space-y-6" id="filter-section">
        {/* Category Filter */}
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              {t(locale, 'projects.filterByCategory')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>
          <div class="flex flex-wrap gap-2" role="group" aria-label={t(locale, 'filter.categoryAria')}>
            <button
              class="filter-btn btn active"
              data-category="all"
              aria-pressed="true"
            >
              {t(locale, 'category.all')}
            </button>
            {
              allCategories.map((category) => {
                const config = categoryLabels[category] || categoryLabels.other;
                return (
                  <button
                    class="filter-btn btn"
                    data-category={category}
                    aria-pressed="false"
                  >
                    {config.label}
                  </button>
                );
              })
            }
          </div>
        </div>

        {/* Tech Filter Toggle */}
        <div>
          <button
            id="tech-filter-toggle"
            class="group flex items-center gap-3 btn"
            aria-expanded="false"
            aria-controls="tech-filter-panel"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 transition-colors group-hover:text-[var(--accent)]"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"
              />
            </svg>
            <span class="text-sm uppercase group-hover:text-[var(--accent)] transition-colors">{t(locale, 'projects.filterByTech')}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4 transition-transform duration-200"
              id="tech-filter-arrow"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m19.5 8.25-7.5 7.5-7.5-7.5"
              />
            </svg>
          </button>

          {/* Active tech indicator */}
          <div id="active-tech-indicator" class="hidden mt-3">
            <button
              id="clear-tech-filter"
              class="btn btn-primary"
            >
              <span id="active-tech-name"></span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-3 h-3"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18 18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>
        </div>

        {/* Tech Filter Panel */}
        <div
          id="tech-filter-panel"
          class="hidden"
          role="group"
          aria-label={t(locale, 'filter.techAria')}
        >
          <div
            class="flex flex-wrap gap-2 pt-4 pb-2 border-t-2" style="border-color: var(--border);"
          >
            {
              allTechnologies.map((tech) => (
                <button
                  class="filter-btn btn"
                  data-tech={tech}
                  aria-pressed="false"
                >
                  {tech}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      {/* Projects Grid */}
      <div id="projects-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-24 animate-stagger-in">
        {sortedProjects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>

      {/* Empty State */}
      <div id="empty-state" class="hidden text-center py-32">
        <div
          class="inline-flex items-center justify-center w-20 h-20 mb-6 border-2" style="border-color: var(--text);"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-10 h-10 text-[var(--text)]"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"
            />
          </svg>
        </div>
        <h3 class="font-display text-2xl font-extrabold uppercase mb-3 text-[var(--text)]">
          {t(locale, 'projects.noMatchTitle')}
        </h3>
        <p class="max-w-md mx-auto text-[var(--text)]">
          {t(locale, 'projects.noMatchDescription')}
        </p>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>

<style>
  .filter-btn {
    border: 2px solid var(--text);
    color: var(--text);
    background-color: var(--bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 2px 2px 0px var(--text);
    line-height: 1;
  }

  .filter-btn:hover {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--text);
  }

  .filter-btn.active {
    background-color: var(--accent);
    color: var(--text);
  }

  .filter-btn.active:hover {
    background-color: var(--accent);
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--text);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoryBtns = document.querySelectorAll('.category-btn');
    const techBtns = document.querySelectorAll('.tech-btn');
    const techFilterToggle = document.getElementById('tech-filter-toggle');
    const techFilterPanel = document.getElementById('tech-filter-panel');
    const techFilterArrow = document.getElementById('tech-filter-arrow');
    const activeTechIndicator = document.getElementById('active-tech-indicator');
    const activeTechName = document.getElementById('active-tech-name');
    const clearTechFilter = document.getElementById('clear-tech-filter');
    const projectsGrid = document.getElementById('projects-grid');
    const projectItems = document.querySelectorAll('.project-card'); // Use .project-card since ProjectCard is refactored
    const emptyState = document.getElementById('empty-state');

    let activeCategory = 'all';
    let activeTech: string | null = null;

    function filterProjects() {
      let visibleCount = 0;

      projectItems.forEach((item, index) => {
        const itemCategory = item.getAttribute('data-category');
        const itemTechnologies = item.getAttribute('data-technologies')?.split(',') || [];

        const matchesCategory = activeCategory === 'all' || itemCategory === activeCategory;
        const matchesTech = !activeTech || itemTechnologies.some(
          (t) => t.toLowerCase() === activeTech?.toLowerCase()
        );

        if (matchesCategory && matchesTech) {
          item.classList.remove('hidden');
          // Reapply stagger animation delay
          (item as HTMLElement).style.setProperty('--delay', `${visibleCount * 50}ms`);
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Show/hide empty state
      if (visibleCount === 0) {
        projectsGrid?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        projectsGrid?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    }

    // Category filter handlers
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        activeCategory = btn.getAttribute('data-category') || 'all';
        filterProjects();
      });
    });

    // Tech filter toggle
    techFilterToggle?.addEventListener('click', () => {
      const isExpanded = techFilterToggle.getAttribute('aria-expanded') === 'true';
      techFilterToggle.setAttribute('aria-expanded', (!isExpanded).toString());
      techFilterPanel?.classList.toggle('hidden');
      techFilterArrow?.style.setProperty('transform', isExpanded ? 'rotate(0deg)' : 'rotate(180deg)');
    });

    // Tech filter handlers
    techBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tech = btn.getAttribute('data-tech');

        if (activeTech === tech) {
          // Deselect
          activeTech = null;
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
          activeTechIndicator?.classList.add('hidden');
        } else {
          // Select new
          techBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          activeTech = tech;

          if (activeTechName) activeTechName.textContent = tech || '';
          activeTechIndicator?.classList.remove('hidden');
        }

        filterProjects();
      });
    });

    // Clear tech filter
    clearTechFilter?.addEventListener('click', () => {
      techBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      activeTech = null;
      activeTechIndicator?.classList.add('hidden');
      filterProjects();
    });
  });
</script>
