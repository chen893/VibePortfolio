---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/layout/Container.astro';
import ImageGallery from '../../components/interactive/ImageGallery';
import TechTag from '../../components/ui/TechTag.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { defaultLocale, t, type Locale } from '../../i18n/ui';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prevProject: index > 0 ? projects[index - 1] : null,
      nextProject: index < projects.length - 1 ? projects[index + 1] : null,
      projectIndex: index,
      totalProjects: projects.length,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prevProject: CollectionEntry<'projects'> | null;
  nextProject: CollectionEntry<'projects'> | null;
  projectIndex: number;
  totalProjects: number;
}

const { project, prevProject, nextProject, projectIndex, totalProjects } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const homeHref = getRelativeLocaleUrl(locale, '/');
const projectsHref = getRelativeLocaleUrl(locale, '/projects');

// Category mapping with colors
const categoryConfig: Record<string, { label: string; color: string }> = {
  web: { label: t(locale, 'category.web.short'), color: '#00f0ff' },
  mobile: { label: t(locale, 'category.mobile.short'), color: '#ff2d92' },
  backend: { label: t(locale, 'category.backend.short'), color: '#e4ff1a' },
  fullstack: { label: t(locale, 'category.fullstack.short'), color: '#00f0ff' },
  tool: { label: t(locale, 'category.tool.short'), color: '#ff2d92' },
  other: { label: t(locale, 'category.other.short'), color: '#a3a3a3' },
};

const category = categoryConfig[data.category] || categoryConfig.other;

// Format date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date).replace(/\//g, '.');
};
---

<BaseLayout
  title={data.seoTitle || data.title}
  description={data.seoDescription || data.description}
>
  <Header />

  <main class="pt-20 min-h-screen relative">


    <Container>
      {/* Breadcrumb */}
      <nav class="py-6 relative z-10" aria-label={t(locale, 'project.breadcrumbAria')}>
        <div class="inline-flex items-center gap-2 px-4 py-2 border-2" style="border-color: var(--text);">
          <span class="text-[var(--accent)]">$</span>
          <a href={homeHref} class="text-[var(--text)]">
            ~
          </a>
          <span class="text-[var(--text)]">/</span>
          <a href={projectsHref} class="text-[var(--text)]">
            projects
          </a>
          <span class="text-[var(--text)]">/</span>
          <span class="text-[var(--text)]">{id}</span>
        </div>
      </nav>

      {/* Project Header */}
      <header class="relative mb-12 pt-8">
        {/* Meta badges */}
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="px-3 py-1.5 text-xs font-bold uppercase border-2" style="border-color: var(--accent); color: var(--accent);">
            {category.label}
          </span>
          {data.featured && (
            <span class="px-3 py-1.5 text-xs font-bold uppercase border-2" style="border-color: var(--accent); color: var(--accent);">
              {t(locale, 'project.featured')}
            </span>
          )}
          <span class="px-3 py-1.5 text-xs uppercase border-2" style="border-color: var(--text); color: var(--text);">
            {formatDate(data.publishedDate)}
          </span>
          <span class="px-3 py-1.5 text-xs uppercase border-2" style="border-color: var(--text); color: var(--text);">
            [{String(projectIndex + 1).padStart(2, '0')}/{String(totalProjects).padStart(2, '0')}]
          </span>
        </div>

        {/* Title */}
        <h1 class="font-display text-5xl font-extrabold uppercase mb-6">
          {data.title}
        </h1>

        {/* Description */}
        <p class="text-xl max-w-3xl mb-8">
          {data.description}
        </p>

        {/* Action Buttons */}
        <div class="flex flex-wrap gap-4">
          {data.liveUrl && (
            <a href={data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary magnetic">
              {t(locale, 'project.liveDemo')}
            </a>
          )}
          {data.repoUrl && (
            <a href={data.repoUrl} target="_blank" rel="noopener noreferrer" class="btn magnetic">
              {t(locale, 'project.viewSource')}
            </a>
          )}
        </div>
      </header>

      {/* Hero Image */}
      <div class="relative mb-16 border-2" style="border-color: var(--text);">
        {data.thumbnail?.src && !data.thumbnail.src.includes('placeholder') ? (
          <div class="relative overflow-hidden">
            <img
              src={data.thumbnail.src}
              alt={data.thumbnail.alt}
              class="w-full aspect-video object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        ) : (
          <div class="w-full aspect-video flex items-center justify-center relative bg-[var(--bg)]">
            <div
              class="relative w-24 h-24 flex items-center justify-center border-2" style="border-color: var(--text);"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-12 h-12 text-[var(--text)]"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"
                />
              </svg>
            </div>
          </div>
        )}
      </div>

      {/* Problem Statement */}
      <section class="relative mb-16">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-sm font-body uppercase text-[var(--text)]">
            {t(locale, 'project.sectionBackground')}
          </span>
          <div class="flex-1 h-px bg-[var(--border)]" />
        </div>
        <div class="p-6 border-2" style="border-color: var(--text);">
          <p class="text-lg leading-relaxed">
            {data.problemStatement}
          </p>
        </div>
      </section>

      {/* Technologies */}
      <section class="relative mb-16">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-sm font-body uppercase text-[var(--text)]">
            {t(locale, 'project.sectionTech')}
          </span>
          <div class="flex-1 h-px bg-[var(--border)]" />
        </div>
        <div class="flex flex-wrap gap-2">
          {data.technologies.map((tech) => (
            <TechTag tech={tech} />
          ))}
        </div>
      </section>

      {/* Project Content (MDX) */}
      <section class="relative mb-16">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-sm font-body uppercase text-[var(--text)]">
            {t(locale, 'project.sectionContent')}
          </span>
          <div class="flex-1 h-px bg-[var(--border)]" />
        </div>
        <div class="prose-brutalist">
          <Content />
        </div>
      </section>

      {/* Image Gallery */}
      {data.images && data.images.length > 0 && (
        <section class="relative mb-16">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              {t(locale, 'project.sectionScreenshots')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>
          <ImageGallery client:load images={data.images} projectTitle={data.title} locale={locale} />
        </section>
      )}

      {/* Project Navigation */}
      <nav class="relative pt-12 pb-20 border-t-2" style="border-color: var(--border);" aria-label={t(locale, 'project.navAria')}>
        <div class="flex justify-between gap-6">
          {prevProject ? (
            <a
              href={getRelativeLocaleUrl(locale, `/projects/${prevProject.id}`)}
              class="group flex-1 max-w-[calc(50%-0.75rem)] relative p-6 btn"
            >
              <div class="flex items-center gap-2 mb-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 text-[var(--text)]"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
                  />
                </svg>
                <span class="text-xs font-body uppercase text-[var(--text)]">{t(locale, 'project.prevProject')}</span>
              </div>
              <div class="font-display font-bold truncate text-[var(--text)]">
                {prevProject.data.title}
              </div>
            </a>
          ) : (
            <div class="flex-1 max-w-[calc(50%-0.75rem)]"></div>
          )}

          {nextProject ? (
            <a
              href={getRelativeLocaleUrl(locale, `/projects/${nextProject.id}`)}
              class="group flex-1 max-w-[calc(50%-0.75rem)] relative p-6 text-right btn"
            >
              <div class="flex items-center justify-end gap-2 mb-2">
                <span class="text-xs font-body uppercase text-[var(--text)]">{t(locale, 'project.nextProject')}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 text-[var(--text)]"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                  />
                </svg>
              </div>
              <div class="font-display font-bold truncate text-[var(--text)]">
                {nextProject.data.title}
              </div>
            </a>
          ) : (
            <div class="flex-1 max-w-[calc(50%-0.75rem)]"></div>
          )}
        </div>

        {/* Back to projects */}
        <div class="flex justify-center mt-8">
          <a
            href={projectsHref}
            class="text-sm font-body uppercase text-[var(--text)]"
          >
            {t(locale, 'project.backToProjects')}
          </a>
        </div>
      </nav>
    </Container>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /* Brutalist prose styling */
  .prose-brutalist {
    font-family: var(--font-body);
    color: var(--text);
    line-height: 1.7;
    font-size: 1.125rem;
  }

  .prose-brutalist h1,
  .prose-brutalist h2,
  .prose-brutalist h3,
  .prose-brutalist h4 {
    font-family: var(--font-display);
    color: var(--text);
    margin-top: 2em;
    margin-bottom: 0.75em;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .prose-brutalist h2 {
    font-size: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .prose-brutalist h3 {
    font-size: 2rem;
  }

  .prose-brutalist p {
    margin-bottom: 1.5em;
  }

  .prose-brutalist a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .prose-brutalist a:hover {
    background-color: var(--accent);
  }

  .prose-brutalist strong {
    color: var(--text);
    font-weight: 700;
  }

  .prose-brutalist em {
    font-style: italic;
  }

  .prose-brutalist code {
    font-family: monospace;
    background: var(--border);
    color: var(--text);
    padding: 0.2em 0.4em;
    font-size: 0.9em;
    border-radius: 4px;
  }

  .prose-brutalist pre {
    background: var(--border);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5em 0;
    border-radius: 8px;
  }

  .prose-brutalist pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--text);
    font-size: 0.9em;
  }

  .prose-brutalist ul,
  .prose-brutalist ol {
    padding-left: 1.5em;
    margin: 1.5em 0;
    list-style-type: square;
  }

  .prose-brutalist li {
    margin-bottom: 0.5em;
  }

  .prose-brutalist blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 1.5rem;
    margin: 1.5em 0;
    font-style: italic;
    color: var(--text);
  }

  .prose-brutalist hr {
    border: none;
    height: 2px;
    background-color: var(--border);
    margin: 3em 0;
  }

  .prose-brutalist img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2em auto;
    border: 2px solid var(--border);
  }

  .prose-brutalist table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-family: var(--font-body);
    font-size: 0.9em;
  }

  .prose-brutalist th,
  .prose-brutalist td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .prose-brutalist th {
    background: var(--border);
    color: var(--text);
    font-weight: 700;
    text-transform: uppercase;
  }

  .prose-brutalist td {
    background: var(--bg);
  }
</style>
