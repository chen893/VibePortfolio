---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import AboutHero from '../components/sections/AboutHero.astro';
import SkillsGrid from '../components/sections/SkillsGrid.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import type { DeveloperProfile } from '../types/profile';
import { getProfile } from '../i18n/profile';
import { defaultLocale, t, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const profile = getProfile(locale);

// Cast profile to proper type
const typedProfile = profile as unknown as DeveloperProfile;
---

<BaseLayout
  title={t(locale, 'about.title')}
  description={profile.seoDescription || t(locale, 'about.metaDescription')}
>
  <Header />

  <main class="pt-20 min-h-screen relative">


    <Container size="md">
      {/* Hero Section */}
      <AboutHero profile={typedProfile} />

      {/* Philosophy Section */}
      <section class="py-16 border-t-2" style="border-color: var(--border);">
        {/* Section header */}
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              {t(locale, 'about.philosophyLabel')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>

          <h2 class="font-display text-5xl font-extrabold uppercase">
            {t(locale, 'about.philosophyTitleA')}
            <br />
            <span class="text-[var(--accent)]">{t(locale, 'about.philosophyTitleB')}</span>
          </h2>
        </div>

        {/* Quote block */}
        <div class="p-8 border-2" style="border-color: var(--text);">
          <blockquote>
            <p class="text-xl leading-relaxed mb-4">
              "{profile.philosophy}"
            </p>
          </blockquote>

        </div>
      </section>

      {/* Skills Section */}
      <section class="py-16 border-t-2" style="border-color: var(--border);">
        {/* Section header */}
        <div class="mb-10">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              {t(locale, 'about.skillsLabel')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>

          <h2 class="font-display text-5xl font-extrabold uppercase">
            {t(locale, 'about.skillsTitleA')}
            <span class="text-[var(--accent)]"> {t(locale, 'about.skillsTitleB')}</span>
          </h2>
        </div>

        <SkillsGrid skills={typedProfile.skills} />
      </section>

      {/* Work Experience Section */}
      {typedProfile.workExperience && typedProfile.workExperience.length > 0 && (
        <section class="py-16 border-t-2" style="border-color: var(--border);">
          {/* Section header */}
          <div class="mb-10">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-sm font-body uppercase text-[var(--text)]">
                {t(locale, 'about.experienceLabel')}
              </span>
              <div class="flex-1 h-px bg-[var(--border)]" />
            </div>

            <h2 class="font-display text-5xl font-extrabold uppercase">
              {t(locale, 'about.experienceTitleA')}
              <span class="text-[var(--accent)]"> {t(locale, 'about.experienceTitleB')}</span>
            </h2>
          </div>

          {/* Experience timeline */}
          <div class="space-y-12">
            {typedProfile.workExperience.map((exp) => (
              <div class="relative pl-8 border-l-2" style="border-color: var(--accent);">
                {/* Timeline dot */}
                <div class="absolute -left-[9px] top-0 w-4 h-4 bg-[var(--accent)] rounded-full" />

                {/* Company header */}
                <div class="mb-6">
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
                    <h3 class="font-display text-2xl font-bold">{exp.company}</h3>
                    <span class="text-sm text-[var(--text-muted)]">{exp.location}</span>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                    <span class="font-mono text-base text-[var(--accent)]">{exp.position}</span>
                    <span class="text-sm text-[var(--text-muted)]">{exp.startDate} - {exp.endDate}</span>
                  </div>
                </div>

                {/* Projects */}
                <div class="space-y-6">
                  {exp.projects.map((project) => (
                    <div class="p-6 bg-[var(--background)] border border-[var(--border)]">
                      <h4 class="font-display text-lg font-bold mb-2">{project.name}</h4>
                      <p class="text-sm text-[var(--text-muted)] mb-4">{project.description}</p>

                      {/* Tech stack */}
                      <div class="flex flex-wrap gap-2 mb-4">
                        {project.techStack.map((tech) => (
                          <span class="px-2 py-1 text-xs font-mono bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/30">
                            {tech}
                          </span>
                        ))}
                      </div>

                      {/* Highlights */}
                      <ul class="space-y-2">
                        {project.highlights.map((highlight) => (
                          <li class="flex gap-3 text-sm">
                            <span class="text-[var(--accent)] flex-shrink-0">▸</span>
                            <span class="text-[var(--text-muted)]">{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Education Section */}
      {typedProfile.education && typedProfile.education.length > 0 && (
        <section class="py-16 border-t-2" style="border-color: var(--border);">
          {/* Section header */}
          <div class="mb-10">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-sm font-body uppercase text-[var(--text)]">
                {t(locale, 'about.educationLabel')}
              </span>
              <div class="flex-1 h-px bg-[var(--border)]" />
            </div>

            <h2 class="font-display text-5xl font-extrabold uppercase">
              {t(locale, 'about.educationTitleA')}
              <span class="text-[var(--accent)]"> {t(locale, 'about.educationTitleB')}</span>
            </h2>
          </div>

          {/* Education cards */}
          <div class="grid gap-6">
            {typedProfile.education.map((edu) => (
              <div class="p-6 bg-[var(--background)] border-2 border-[var(--border)] hover:border-[var(--text)] transition-colors">
                <div class="flex flex-wrap items-baseline justify-between gap-4 mb-2">
                  <h3 class="font-display text-xl font-bold">{edu.school}</h3>
                  <span class="text-sm text-[var(--text-muted)] font-mono">{edu.startDate} - {edu.endDate}</span>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="text-base text-[var(--accent)]">{edu.major}</span>
                  <span class="text-sm text-[var(--text-muted)]">·</span>
                  <span class="text-sm text-[var(--text-muted)]">{edu.degree}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Awards Section */}
      {typedProfile.awards && typedProfile.awards.length > 0 && (
        <section class="py-16 border-t-2" style="border-color: var(--border);">
          {/* Section header */}
          <div class="mb-10">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-sm font-body uppercase text-[var(--text)]">
                {t(locale, 'about.awardsLabel')}
              </span>
              <div class="flex-1 h-px bg-[var(--border)]" />
            </div>

            <h2 class="font-display text-5xl font-extrabold uppercase">
              {t(locale, 'about.awardsTitleA')}
              <span class="text-[var(--accent)]"> {t(locale, 'about.awardsTitleB')}</span>
            </h2>
          </div>

          {/* Awards grid */}
          <div class="grid sm:grid-cols-2 gap-4">
            {typedProfile.awards.map((award) => (
              <div class="group p-5 bg-[var(--background)] border border-[var(--border)] hover:border-[var(--accent)] transition-colors">
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/30">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-2.746 0" />
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-display text-base font-bold mb-1 group-hover:text-[var(--accent)] transition-colors">{award.title}</h3>
                    <span class="text-xs font-mono text-[var(--text-muted)]">{award.date}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Contact Section */}
      <section class="py-16 pb-24 border-t-2" style="border-color: var(--border);">
        {/* Section header */}
        <div class="mb-10">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text-muted)]">
              {t(locale, 'about.contactLabel')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>

          <h2 class="font-display text-4xl md:text-5xl font-extrabold uppercase">
            {t(locale, 'about.contactTitleA')}
            <span class="text-[var(--accent-dark)]"> {t(locale, 'about.contactTitleB')}</span>
          </h2>
        </div>

        <p class="text-base text-[var(--text-muted)] mb-10 max-w-xl leading-relaxed">
          {t(locale, 'about.contactDescription')}
        </p>

        {/* Contact methods */}
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          {
            profile.contact.email && (
              <a
                href={`mailto:${profile.contact.email}`}
                class="group flex-1 flex items-center gap-4 p-5 bg-[var(--background)] border border-[var(--border)] hover:border-[var(--text)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-6 h-6 text-[var(--accent-dark)] flex-shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  />
                </svg>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-body uppercase text-[var(--text-muted)] mb-1">Email</div>
                  <div class="font-mono text-sm text-[var(--text)] truncate lowercase">{profile.contact.email}</div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent-dark)] transition-colors"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            )
          }

          {
            profile.contact.phone && (
              <a
                href={`tel:${profile.contact.phone}`}
                class="group flex-1 flex items-center gap-4 p-5 bg-[var(--background)] border border-[var(--border)] hover:border-[var(--text)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-6 h-6 text-[var(--accent-dark)] flex-shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                  />
                </svg>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-body uppercase text-[var(--text-muted)] mb-1">Phone</div>
                  <div class="font-mono text-sm text-[var(--text)] truncate">{profile.contact.phone}</div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent-dark)] transition-colors"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            )
          }
        </div>




      </section>
    </Container>
  </main>

  <Footer />
</BaseLayout>
