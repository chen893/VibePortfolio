---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import AboutHero from '../components/sections/AboutHero.astro';
import SkillsGrid from '../components/sections/SkillsGrid.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import type { DeveloperProfile } from '../types/profile';
import { getProfile } from '../i18n/profile';
import { defaultLocale, t, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const profile = getProfile(locale);

// Cast profile to proper type
const typedProfile = profile as unknown as DeveloperProfile;
---

<BaseLayout
  title={t(locale, 'about.title')}
  description={profile.seoDescription || t(locale, 'about.metaDescription')}
>
  <Header />

  <main class="pt-20 min-h-screen relative">


    <Container size="md">
      {/* Hero Section */}
      <AboutHero profile={typedProfile} />

      {/* Philosophy Section */}
      <section class="py-16 border-t-2" style="border-color: var(--border);">
        {/* Section header */}
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              {t(locale, 'about.philosophyLabel')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>

          <h2 class="font-display text-5xl font-extrabold uppercase">
            {t(locale, 'about.philosophyTitleA')}
            <br />
            <span class="text-[var(--accent)]">{t(locale, 'about.philosophyTitleB')}</span>
          </h2>
        </div>

        {/* Quote block */}
        <div class="p-8 border-2" style="border-color: var(--text);">
          <blockquote>
            <p class="text-xl leading-relaxed mb-4">
              "{profile.philosophy}"
            </p>
          </blockquote>
          <div class="flex items-center gap-3 pt-4 border-t-2" style="border-color: var(--border);">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              &mdash; {profile.name}
            </span>
          </div>
        </div>
      </section>

      {/* Skills Section */}
      <section class="py-16 border-t-2" style="border-color: var(--border);">
        {/* Section header */}
        <div class="mb-10">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text)]">
              {t(locale, 'about.skillsLabel')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>

          <h2 class="font-display text-5xl font-extrabold uppercase">
            {t(locale, 'about.skillsTitleA')}
            <span class="text-[var(--accent)]"> {t(locale, 'about.skillsTitleB')}</span>
          </h2>
        </div>

        <SkillsGrid skills={typedProfile.skills} />
      </section>

      {/* Contact Section */}
      <section class="py-16 pb-24 border-t-2" style="border-color: var(--border);">
        {/* Section header */}
        <div class="mb-10">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-sm font-body uppercase text-[var(--text-muted)]">
              {t(locale, 'about.contactLabel')}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]" />
          </div>

          <h2 class="font-display text-4xl md:text-5xl font-extrabold uppercase">
            {t(locale, 'about.contactTitleA')}
            <span class="text-[var(--accent-dark)]"> {t(locale, 'about.contactTitleB')}</span>
          </h2>
        </div>

        <p class="text-base text-[var(--text-muted)] mb-10 max-w-xl leading-relaxed">
          {t(locale, 'about.contactDescription')}
        </p>

        {/* Contact methods */}
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          {
            profile.contact.email && (
              <a
                href={`mailto:${profile.contact.email}`}
                class="group flex-1 flex items-center gap-4 p-5 bg-[var(--background)] border border-[var(--border)] hover:border-[var(--text)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-6 h-6 text-[var(--accent-dark)] flex-shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  />
                </svg>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-body uppercase text-[var(--text-muted)] mb-1">Email</div>
                  <div class="font-mono text-sm text-[var(--text)] truncate lowercase">{profile.contact.email}</div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent-dark)] transition-colors"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            )
          }

          {
            profile.contact.phone && (
              <a
                href={`tel:${profile.contact.phone}`}
                class="group flex-1 flex items-center gap-4 p-5 bg-[var(--background)] border border-[var(--border)] hover:border-[var(--text)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-6 h-6 text-[var(--accent-dark)] flex-shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                  />
                </svg>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-body uppercase text-[var(--text-muted)] mb-1">Phone</div>
                  <div class="font-mono text-sm text-[var(--text)] truncate">{profile.contact.phone}</div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent-dark)] transition-colors"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            )
          }
        </div>




      </section>
    </Container>
  </main>

  <Footer />
</BaseLayout>
