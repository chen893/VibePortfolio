---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/interactive/Hero';
import CopyableEmail from '../components/interactive/CopyableEmail';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { getProfile } from '../i18n/profile';
import { defaultLocale, t, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const profile = getProfile(locale);
const projectsHref = getRelativeLocaleUrl(locale, '/projects');
const aboutHref = getRelativeLocaleUrl(locale, '/about');

// 获取精选项目
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={t(locale, 'nav.home')} description={profile.seoDescription}>
  <Header />

  <main>
    <!-- Hero Section -->
    <Hero
      client:load
      name={profile.name}
      title={profile.title}
      bio={profile.bio}
      locale={locale}
      projectsHref={projectsHref}
      aboutHref={aboutHref}
    />

    <!-- Featured Projects Section -->
    {
      featuredProjects.length > 0 && (
        <section class="py-24">
          <Container>
            {/* Section header */}
            <div class="mb-12">
              {/* Label */}
              <div class="flex items-center gap-4 mb-4">
                <span class="text-sm font-body uppercase text-[var(--text)]">
                  {t(locale, 'home.featuredLabel')}
                </span>
                <div class="flex-1 h-px bg-[var(--border)]" />
              </div>

              {/* Title */}
              <h2 class="font-display text-5xl font-extrabold uppercase">
                {t(locale, 'home.featuredTitleA')}
                <br />
                <span class="text-[var(--accent)]">{t(locale, 'home.featuredTitleB')}</span>
              </h2>
            </div>

            {/* Projects grid */}
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16 animate-stagger-in">
              {featuredProjects.map((project, index) => (
                <ProjectCard project={project} index={index} />
              ))}
            </div>

            {/* View all link */}
            <div class="flex justify-center">
              <a href={projectsHref} class="btn btn-primary magnetic">
                {t(locale, 'home.viewAllProjects')}
              </a>
            </div>
          </Container>
        </section>
      )
    }

    <!-- CTA Section -->
    <section class="py-24 border-t-2" style="border-color: var(--border);">
      <Container size="md">
        <div class="text-center max-w-lg mx-auto">
          {/* Label */}
          <p class="text-sm font-body uppercase mb-6 text-[var(--text-muted)] tracking-wider">
            {t(locale, 'home.ctaBadge')}
          </p>

          {/* Heading */}
          <h2 class="font-display text-4xl md:text-5xl font-extrabold uppercase mb-4">
            {t(locale, 'home.ctaTitleA')}
            <br />
            <span class="text-[var(--accent-dark)]">
              {t(locale, 'home.ctaTitleB')}
            </span>
          </h2>

          {/* Description */}
          <p class="text-base leading-relaxed max-w-md mx-auto mb-10 text-[var(--text-muted)]">
            {t(locale, 'home.ctaDescription')}
          </p>

 

          {/* Contact Button */}
          <a href={aboutHref} class="btn btn-primary magnetic">
            {t(locale, 'home.ctaContact')}
          </a>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
