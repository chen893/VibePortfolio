---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/interactive/Hero';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';

// 获取精选项目
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title="首页" description={profile.seoDescription}>
  <Header />

  <main>
    <!-- Hero Section -->
    <Hero
      client:load
      name={profile.name}
      title={profile.title}
      bio={profile.bio}
    />

    <!-- Featured Projects Section -->
    {
      featuredProjects.length > 0 && (
        <section class="relative py-32 overflow-hidden" style="background: #050505;">
          {/* Background effects */}
          <div class="absolute inset-0 pointer-events-none">
            {/* Gradient orbs */}
            <div
              class="absolute top-0 right-0 w-[600px] h-[600px]"
              style="background: radial-gradient(circle, rgba(0,240,255,0.08) 0%, transparent 70%); filter: blur(60px);"
            />
            <div
              class="absolute bottom-0 left-0 w-[500px] h-[500px]"
              style="background: radial-gradient(circle, rgba(255,45,146,0.05) 0%, transparent 70%); filter: blur(60px);"
            />

            {/* Grid overlay */}
            <div
              class="absolute inset-0 opacity-[0.02]"
              style="background-image: linear-gradient(#00f0ff 1px, transparent 1px), linear-gradient(90deg, #00f0ff 1px, transparent 1px); background-size: 60px 60px;"
            />
          </div>

          <Container>
            {/* Section header */}
            <div class="relative mb-16">
              {/* Label */}
              <div class="flex items-center gap-4 mb-6">
                <span
                  class="text-xs tracking-[0.3em] uppercase"
                  style="color: #525252; font-family: 'Space Mono', monospace;"
                >
                  {'// 精选作品'}
                </span>
                <div class="flex-1 h-px" style="background: linear-gradient(90deg, #262626, transparent);" />
              </div>

              {/* Title */}
              <h2
                class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight"
                style="font-family: 'Clash Display', sans-serif;"
              >
                <span style="color: #fafafa;">FEATURED</span>
                <br />
                <span style="color: #00f0ff;">PROJECTS</span>
              </h2>

              {/* Decorative number */}
              <div
                class="absolute -top-4 -right-4 text-[8rem] font-bold leading-none opacity-5 hidden lg:block"
                style="font-family: 'Clash Display', sans-serif; color: #00f0ff;"
              >
                03
              </div>
            </div>

            {/* Projects grid */}
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
              {featuredProjects.map((project, index) => (
                <div
                  class="animate-slide-in"
                  style={`animation-delay: ${index * 150}ms;`}
                >
                  <ProjectCard project={project} index={index} />
                </div>
              ))}
            </div>

            {/* View all link */}
            <div class="flex justify-center">
              <a
                href="/projects"
                class="group relative inline-flex items-center gap-3 px-8 py-4 font-medium text-sm tracking-wider uppercase transition-all duration-300"
                style="
                  border: 1px solid #262626;
                  color: #a3a3a3;
                  font-family: 'Space Mono', monospace;
                "
              >
                {/* Corner accents */}
                <div class="absolute -top-px -left-px w-3 h-3 border-t border-l transition-all duration-300 group-hover:w-full group-hover:h-full" style="border-color: #00f0ff;" />
                <div class="absolute -bottom-px -right-px w-3 h-3 border-b border-r transition-all duration-300 group-hover:w-full group-hover:h-full" style="border-color: #ff2d92;" />

                <span class="relative z-10 group-hover:text-white transition-colors">
                  VIEW_ALL_PROJECTS
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
                  style="color: #00f0ff;"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                  />
                </svg>
              </a>
            </div>
          </Container>
        </section>
      )
    }

    <!-- CTA Section -->
    <section class="relative py-32 overflow-hidden" style="background: #0d0d0d;">
      {/* Background decorations */}
      <div class="absolute inset-0 pointer-events-none">
        {/* Diagonal lines */}
        <div
          class="absolute top-0 left-1/4 w-px h-full opacity-10"
          style="background: linear-gradient(180deg, transparent, #00f0ff, transparent);"
        />
        <div
          class="absolute top-0 right-1/4 w-px h-full opacity-10"
          style="background: linear-gradient(180deg, transparent, #ff2d92, transparent);"
        />

        {/* Corner brackets */}
        <div class="absolute top-8 left-8 w-20 h-20 border-l-2 border-t-2 opacity-20" style="border-color: #00f0ff;" />
        <div class="absolute bottom-8 right-8 w-20 h-20 border-r-2 border-b-2 opacity-20" style="border-color: #ff2d92;" />
      </div>

      <Container size="md">
        <div class="relative text-center">
          {/* Label */}
          <div
            class="inline-flex items-center gap-2 px-4 py-2 mb-8"
            style="border: 1px solid #262626; font-family: 'Space Mono', monospace;"
          >
            <span
              class="w-2 h-2 rounded-full animate-pulse"
              style="background: #22c55e; box-shadow: 0 0 10px #22c55e;"
            />
            <span class="text-xs tracking-wider" style="color: #525252;">
              OPEN_FOR_COLLABORATION
            </span>
          </div>

          {/* Heading */}
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6"
            style="font-family: 'Clash Display', sans-serif;"
          >
            <span style="color: #fafafa;">LET'S BUILD</span>
            <br />
            <span
              style="background: linear-gradient(135deg, #00f0ff, #ff2d92); -webkit-background-clip: text; background-clip: text; color: transparent;"
            >
              SOMETHING GREAT
            </span>
          </h2>

          {/* Description */}
          <p
            class="text-lg max-w-xl mx-auto mb-10"
            style="color: #737373; font-family: 'Space Grotesk', sans-serif;"
          >
            无论是新项目、工作机会还是只是想聊聊技术，都欢迎与我联系。
          </p>

          {/* CTA Buttons */}
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/about"
              class="btn-primary"
            >
              GET_IN_TOUCH
            </a>
            <a
              href={`mailto:${profile.contact.email}`}
              class="btn-secondary"
            >
              SEND_EMAIL
            </a>
          </div>

          {/* Decorative code block */}
          <div
            class="mt-16 inline-block text-left p-4 opacity-30"
            style="background: #171717; border: 1px solid #262626; font-family: 'Space Mono', monospace; font-size: 0.75rem; color: #525252;"
          >
            <div><span style="color: #00f0ff;">const</span> collaboration = {'{'}</div>
            <div class="pl-4">status: <span style="color: #e4ff1a;">"active"</span>,</div>
            <div class="pl-4">response_time: <span style="color: #e4ff1a;">"< 24h"</span></div>
            <div>{'}'};</div>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes slideIn {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-in {
    animation: slideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    opacity: 0;
  }
</style>
