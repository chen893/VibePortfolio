  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  email: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>`,
  weibo: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M10.098 20c-4.612 0-9.098-2.098-9.098-5.937 0-1.922.886-4.032 2.413-5.913 2.038-2.511 4.393-3.647 5.265-2.532.39.499.382 1.269.026 2.125-.168.403.247.2.247.2 1.138-.475 2.163-.604 2.542-.083.202.277.199.704-.026 1.203-.09.197.078.29.078.29 3.049.592 5.168 2.528 5.168 4.776 0 3.372-3.274 5.871-6.615 5.871zm-1.64-9.473c-2.466-.069-4.583 1.568-4.727 3.655-.146 2.088 1.748 3.86 4.232 3.96 2.552.103 4.697-1.566 4.792-3.724.095-2.118-1.831-3.823-4.297-3.891zm-.023 5.932c-1.126.078-2.092-.691-2.154-1.715-.063-1.024.799-1.93 1.924-2.022 1.158-.095 2.141.684 2.2 1.74.062 1.074-.828 1.916-1.97 1.997zm.753-2.344c-.283.034-.506.257-.49.497.015.24.264.413.553.388.295-.027.521-.253.504-.497-.016-.249-.273-.423-.567-.388z"/></svg>`,
  bilibili: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.659.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373z"/></svg>`,
  other: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`,
};
---

<footer
  class={`relative overflow-hidden ${className}`}
  style="background: #0d0d0d; border-top: 1px solid #262626;"
>
  {/* Top gradient line */}
  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(90deg, transparent, #00f0ff, #ff2d92, transparent);"
  />

  {/* Grid background */}
  <div
    class="absolute inset-0 opacity-5"
    style="background-image: linear-gradient(#00f0ff 1px, transparent 1px), linear-gradient(90deg, #00f0ff 1px, transparent 1px); background-size: 40px 40px;"
  />

  <div class="container-custom relative z-10 py-16">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      {/* Brand section */}
      <div>
        {/* Logo */}
        <a href={homeHref} class="inline-flex items-center gap-3 mb-6 group">
          <div
            class="relative w-10 h-10 flex items-center justify-center transition-all duration-300 group-hover:shadow-[0_0_20px_rgba(0,240,255,0.3)]"
            style="border: 1px solid rgba(0, 240, 255, 0.5);"
          >
            <span
              class="text-lg font-bold"
              style="font-family: 'Clash Display', sans-serif; color: #00f0ff;"
            >
              V
            </span>
          </div>
          <div>
            <span
              class="text-sm font-bold tracking-wider"
              style="font-family: 'Clash Display', sans-serif; color: #fafafa;"
            >
              VIBE
            </span>
            <span
              class="text-sm font-bold tracking-wider"
              style="font-family: 'Clash Display', sans-serif; color: #00f0ff;"
            >
              PORTFOLIO
            </span>
          </div>
        </a>

        <p
          class="text-sm leading-relaxed mb-6 max-w-xs"
          style="color: #737373; font-family: 'Space Grotesk', sans-serif;"
        >
          {t(locale, 'footer.tagline')}
        </p>

        {/* Status */}
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs"
          style="font-family: 'Space Mono', monospace; border: 1px solid #262626; color: #525252;"
        >
          <span
            class="w-2 h-2 rounded-full animate-pulse"
            style="background: #22c55e; box-shadow: 0 0 10px #22c55e;"
          />
          <span>{t(locale, 'footer.openForCollab')}</span>
        </div>
      </div>

      {/* Quick links */}
      <div>
        <h4
          class="text-xs tracking-[0.3em] uppercase mb-6"
          style="color: #525252; font-family: 'Space Mono', monospace;"
        >
          {'// NAVIGATION'}
        </h4>
        <ul class="space-y-3">
          {[
            { href: getRelativeLocaleUrl(locale, '/'), label: t(locale, 'nav.home'), code: '01' },
            { href: getRelativeLocaleUrl(locale, '/projects'), label: t(locale, 'nav.projects'), code: '02' },
            { href: getRelativeLocaleUrl(locale, '/about'), label: t(locale, 'nav.about'), code: '03' },
          ].map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex items-center gap-3 transition-all duration-300"
                style="color: #a3a3a3;"
              >
                <span
                  class="text-xs"
                  style="color: #ff2d92; font-family: 'Space Mono', monospace;"
                >
                  {link.code}
                </span>
                <span
                  class="group-hover:text-[#00f0ff] group-hover:translate-x-1 transition-all duration-300"
                  style="font-family: 'Space Grotesk', sans-serif;"
                >
                  {link.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Connect */}
      <div>
        <h4
          class="text-xs tracking-[0.3em] uppercase mb-6"
          style="color: #525252; font-family: 'Space Mono', monospace;"
        >
          {'// CONNECT'}
        </h4>

        {/* Social links */}
        <div class="flex flex-wrap gap-3 mb-6">
          {
            profile.socials.map((social, index) => (
              <a
                href={social.url}
                target={social.platform !== 'email' ? '_blank' : undefined}
                rel={social.platform !== 'email' ? 'noopener noreferrer' : undefined}
                class="group relative w-10 h-10 flex items-center justify-center transition-all duration-300"
                style="border: 1px solid #262626; color: #737373;"
                aria-label={social.label}
                title={social.label}
              >
                {/* Corner accents on hover */}
                <div class="absolute -top-px -left-px w-2 h-2 border-t border-l opacity-0 group-hover:opacity-100 transition-opacity" style="border-color: #00f0ff;" />
                <div class="absolute -bottom-px -right-px w-2 h-2 border-b border-r opacity-0 group-hover:opacity-100 transition-opacity" style="border-color: #00f0ff;" />

                <span class="group-hover:text-[#00f0ff] transition-colors">
                  <Fragment set:html={socialIcons[social.platform] || socialIcons.other} />
                </span>
              </a>
            ))
          }
        </div>

        {/* Email */}
        {profile.contact.email && (
          <a
            href={`mailto:${profile.contact.email}`}
            class="inline-flex items-center gap-2 text-sm transition-all duration-300 group"
            style="color: #737373; font-family: 'Space Mono', monospace;"
          >
            <span class="group-hover:text-[#00f0ff]">{profile.contact.email}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
              style="color: #00f0ff;"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        )}
      </div>
    </div>

    {/* Bottom bar */}
    <div
      class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
      style="border-top: 1px solid #262626;"
    >
      <div
        class="text-xs"
        style="color: #525252; font-family: 'Space Mono', monospace;"
      >
        © {currentYear} {profile.name}. {t(locale, 'footer.rights')}
      </div>

      <div
        class="flex items-center gap-6 text-xs"
        style="color: #404040; font-family: 'Space Mono', monospace;"
      >
        <span class="flex items-center gap-2">
          <span style="color: #00f0ff;">▲</span>
          ASTRO
        </span>
        <span class="flex items-center gap-2">
          <span style="color: #ff2d92;">◆</span>
          TAILWIND
        </span>
        <span class="flex items-center gap-2">
          <span style="color: #e4ff1a;">●</span>
          REACT
        </span>
      </div>
    </div>
  </div>

  {/* Corner decorations */}
  <div class="absolute bottom-8 left-8 w-16 h-16 border-l border-b opacity-20" style="border-color: #00f0ff;" />
  <div class="absolute bottom-8 right-8 w-16 h-16 border-r border-b opacity-20" style="border-color: #ff2d92;" />
</footer>
