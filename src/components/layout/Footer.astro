---
import { getProfile } from '../../i18n/profile';
import { defaultLocale, t, type Locale } from '../../i18n/ui';
import SocialLinks from '../ui/SocialLinks.astro';

const currentYear = new Date().getFullYear();
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const profile = getProfile(locale);
---

<footer
  class="border-t-2"
  style={{
    backgroundColor: 'var(--bg)',
    borderColor: 'var(--text)',
  }}
>
  <div class="container-custom py-8">
    <div class="flex flex-col-reverse gap-4 md:flex-row md:items-center md:justify-between">
      <div class="text-center text-sm font-semibold md:text-left">
        &copy; {currentYear} {profile.name}. {t(locale, 'footer.rights')}
      </div>
    </div>
  </div>
</footer>
