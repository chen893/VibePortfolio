---
import MobileNav from './MobileNav';
import { getPathByLocale, getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, t, type Locale } from '../../i18n/ui';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

const normalizePath = (path: string) => (path !== '/' ? path.replace(/\/+$/, '') : '/');

const stripLocaleFromPathname = (pathname: string) => {
  const localePrefix = `/${getPathByLocale(locale)}`;
  if (pathname === localePrefix) return '/';
  if (pathname.startsWith(`${localePrefix}/`)) return pathname.slice(localePrefix.length) || '/';
  return pathname;
};

const pathWithoutLocale = stripLocaleFromPathname(Astro.url.pathname);
const zhHref = getRelativeLocaleUrl('zh', pathWithoutLocale);
const enHref = getRelativeLocaleUrl('en', pathWithoutLocale);
const homeHref = getRelativeLocaleUrl(locale, '/');

const navLinks = [
  { href: getRelativeLocaleUrl(locale, '/'), label: t(locale, 'nav.home') },
  { href: getRelativeLocaleUrl(locale, '/projects'), label: t(locale, 'nav.projects') },
  { href: getRelativeLocaleUrl(locale, '/about'), label: t(locale, 'nav.about') },
];

const currentPath = normalizePath(Astro.url.pathname);
---

<header
  class:list={[
    'fixed top-0 left-0 right-0 z-50 border-b-2 transition-colors duration-300',
    className,
  ]}
  style={{
    backgroundColor: 'var(--bg)',
    borderColor: 'var(--text)',
  }}
>
  <nav class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a href={homeHref} class="font-display text-2xl font-extrabold uppercase" aria-label={t(locale, 'header.homeAria')}>
        VIBE
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-6" role="navigation">
        {
          navLinks.map((link) => {
            const isActive = currentPath === normalizePath(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "relative text-sm font-bold uppercase tracking-wider",
                    { 'nav-active': isActive },
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- Language Switch & Mobile Nav -->
      <div class="flex items-center gap-4">
        <div
          class="hidden sm:flex items-center gap-2 text-sm font-semibold uppercase"
          aria-label={t(locale, 'lang.switch')}
        >
          <a href={zhHref} class:list={[{ 'lang-active': locale === 'zh' }]}>中文</a>
          <span>/</span>
          <a href={enHref} class:list={[{ 'lang-active': locale === 'en' }]}>EN</a>
        </div>

        <MobileNav client:load links={navLinks} currentPath={currentPath} locale={locale} />
      </div>
    </div>
  </nav>
</header>

<!-- Spacer to prevent content from going under fixed header -->
<div class="h-20 md:h-24"></div>

<style>
  a {
    text-decoration: none; /* Override global link style for header */
  }

  /* Keep the new global link hover, but remove the default underline */
  ul a:hover {
    background-color: var(--accent);
  }

  .nav-active {
    /* Style for active navigation link */
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .lang-active {
    /* Style for active language */
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .lang-active:hover {
    background-color: transparent; /* Don't apply bg color to active lang on hover */
  }
</style>
