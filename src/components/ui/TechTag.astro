---
interface Props {
  tech: string;
  color?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { tech, color, size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'px-1.5 py-0.5 text-xs',
  md: 'px-2 py-1 text-xs',
  lg: 'px-3 py-1.5 text-sm',
};
---

<span
  class={`inline-flex items-center font-medium rounded ${sizeClasses[size]} ${className}`}
  style={color ? `background-color: ${color}20; color: ${color}` : ''}
>
  {!color && <span class="bg-dark-800 text-dark-300">{tech}</span>}
  {color && tech}
</span>
