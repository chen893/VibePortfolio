---
import type { SocialLink } from '../../types/profile';

interface Props {
  links: SocialLink[];
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { links, size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'w-9 h-9',
  md: 'w-11 h-11',
  lg: 'w-14 h-14',
};

const iconSizes = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

// Platform icons as SVG paths
const platformIcons: Record<string, string> = {
  github: `<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd" />`,
  linkedin: `<path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />`,
  twitter: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />`,
  email: `<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />`,
  website: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />`,
};

// Platform colors - cyberpunk palette
const platformColors: Record<string, string> = {
  github: '#fafafa',
  linkedin: '#00f0ff',
  twitter: '#fafafa',
  email: '#ff2d92',
  website: '#e4ff1a',
};
---

<div class={`flex items-center gap-4 ${className}`}>
  {
    links.map((link, index) => (
      <a
        href={link.url}
        target={link.url.startsWith('mailto:') ? undefined : '_blank'}
        rel={link.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        class={`social-link group relative ${sizeClasses[size]} inline-flex items-center justify-center transition-all duration-300 hover:-translate-y-1`}
        style={`--color: ${platformColors[link.platform] || '#fafafa'}; --delay: ${index * 50}ms; background: #171717; border: 1px solid #262626;`}
        aria-label={link.label}
        title={link.label}
      >
        {/* Corner accents */}
        <div class="absolute top-0 left-0 w-2 h-2 border-t border-l opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`border-color: var(--color);`} />
        <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`border-color: var(--color);`} />

        {/* Hover glow */}
        <div
          class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          style={`background: radial-gradient(circle, var(--color)20 0%, transparent 70%);`}
        />

        {/* Icon */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill={link.platform === 'email' || link.platform === 'website' ? 'none' : 'currentColor'}
          stroke={link.platform === 'email' || link.platform === 'website' ? 'currentColor' : 'none'}
          stroke-width={link.platform === 'email' || link.platform === 'website' ? '1.5' : '0'}
          class={`${iconSizes[size]} relative z-10 transition-colors duration-300`}
          style="color: #737373;"
          aria-hidden="true"
        >
          <Fragment set:html={platformIcons[link.platform] || platformIcons.website} />
        </svg>
      </a>
    ))
  }
</div>

<style>
  .social-link:hover svg {
    color: var(--color) !important;
    filter: drop-shadow(0 0 8px var(--color));
  }

  .social-link:hover {
    border-color: var(--color) !important;
    box-shadow: 0 0 20px var(--color)20;
  }
</style>
