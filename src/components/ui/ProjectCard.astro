---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, type Locale } from '../../i18n/ui';
import TechTag from './TechTag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  index?: number;
}

const { project, class: className = '', index } = Astro.props;
const { data, id } = project;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

const delayClasses = ['delay-100', 'delay-200', 'delay-300', 'delay-400', 'delay-500'];
const delayClass = typeof index === 'number' ? delayClasses[index % delayClasses.length] : '';
---

<a href={getRelativeLocaleUrl(locale, `/projects/${id}`)} class:list={['card group block', className, delayClass]}>
  <div class="overflow-hidden mb-4 border-2 border-[var(--text)]">
    <img
      src={data.thumbnail.src}
      alt={data.thumbnail.alt}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover aspect-video transition-transform duration-500 ease-in-out group-hover:scale-105"
    />
  </div>

  <div class="p-2">
    <h3 class="font-display text-2xl font-bold uppercase mb-2">
      {data.title}
    </h3>

    <p class="text-base mb-4 line-clamp-3">
      {data.description}
    </p>

    <div class="flex flex-wrap gap-2">
      {
        data.technologies.slice(0, 4).map((tech) => (
          <TechTag tech={tech} />
        ))
      }
      {
        data.technologies.length > 4 && (
          <TechTag tech={`+${data.technologies.length - 4}`} />
        )
      }
    </div>
  </div>
</a>
