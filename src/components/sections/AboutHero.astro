---
import type { DeveloperProfile } from '../../types/profile';
import SocialLinks from '../ui/SocialLinks.astro';
import { defaultLocale, t, type Locale } from '../../i18n/ui';

interface Props {
  profile: DeveloperProfile;
  class?: string;
}

const { profile, class: className = '' } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
---

<section class={`py-16 md:py-24 ${className}`}>
  <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
    <!-- Avatar -->
    <div class="flex-shrink-0 relative w-48 h-48 md:w-56 md:h-56 border-2" style="border-color: var(--text);">
      {
        profile.avatar?.src && !profile.avatar.src.includes('placeholder') ? (
          <img
            src={profile.avatar.src}
            alt={profile.avatar.alt}
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-[var(--accent)]">
            <span class="text-6xl md:text-7xl font-display font-extrabold text-[var(--text)]">
              {profile.name.charAt(0)}
            </span>
          </div>
        )
      }
    </div>

    <!-- Content -->
    <div class="flex-1 text-center lg:text-left">
      {/* Label */}
      <div class="flex items-center justify-center lg:justify-start gap-4 mb-4">
        <span class="text-sm font-body uppercase text-[var(--text)]">
          {t(locale, 'aboutHero.label')}
        </span>
        <div class="hidden lg:block flex-1 max-w-32 h-px bg-[var(--border)]" />
      </div>

      {/* Name */}
      <h1 class="font-display text-5xl font-extrabold uppercase mb-4">
        {profile.name}
      </h1>

      {/* Title badge */}
      <p class="font-body text-xl uppercase mb-6 text-[var(--text)]">
        {profile.title}
      </p>

      {/* Bio */}
      <p class="text-lg leading-relaxed mb-8 max-w-2xl mx-auto lg:mx-0">
        {profile.bio}
      </p>

      {/* Stats row */}
      <div class="flex flex-wrap justify-center lg:justify-start gap-6 mb-8">
        <div class="text-center">
          <div class="font-display text-3xl font-bold mb-1 text-[var(--accent)]">
            5+
          </div>
          <div class="text-xs font-body uppercase text-[var(--text)]">
            {t(locale, 'aboutHero.years')}
          </div>
        </div>
        <div class="w-px h-12 bg-[var(--border)]" />
        <div class="text-center">
          <div class="font-display text-3xl font-bold mb-1 text-[var(--accent)]">
            50+
          </div>
          <div class="text-xs font-body uppercase text-[var(--text)]">
            {t(locale, 'aboutHero.projects')}
          </div>
        </div>
        <div class="w-px h-12 bg-[var(--border)]" />
        <div class="text-center">
          <div class="font-display text-3xl font-bold mb-1 text-[var(--accent)]">
            10+
          </div>
          <div class="text-xs font-body uppercase text-[var(--text)]">
            {t(locale, 'aboutHero.stack')}
          </div>
        </div>
      </div>

      {/* Social links */}
      <SocialLinks links={profile.socials} />
    </div>
  </div>
</section>
