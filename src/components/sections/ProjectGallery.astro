---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  class?: string;
}

const { projects, class: className = '' } = Astro.props;
---

<section class={`py-16 ${className}`}>
  {
    projects.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20" id="empty-state">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-dark-800 mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-8 h-8 text-dark-500"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">没有找到项目</h3>
        <p class="text-dark-400 max-w-md mx-auto">
          当前筛选条件下没有匹配的项目，请尝试调整筛选条件。
        </p>
      </div>
    )
  }
</section>
