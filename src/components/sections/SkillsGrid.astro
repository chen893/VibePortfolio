---
import type { Skill } from '../../types/profile';
import { defaultLocale, t, type Locale } from '../../i18n/ui';

interface Props {
  skills: Skill[];
  class?: string;
}

const { skills, class: className = '' } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

// Group skills by category
const groupedSkills = skills.reduce(
  (acc, skill) => {
    if (!acc[skill.category]) {
      acc[skill.category] = [];
    }
    acc[skill.category].push(skill);
    return acc;
  },
  {} as Record<string, Skill[]>
);

// Category labels
const categoryLabels: Record<string, string> = {
  frontend: t(locale, 'skills.category.frontend'),
  backend: t(locale, 'skills.category.backend'),
  database: t(locale, 'skills.category.database'),
  devops: t(locale, 'skills.category.devops'),
  tools: t(locale, 'skills.category.tools'),
  other: t(locale, 'skills.category.other'),
};

// Proficiency labels
const proficiencyLabels: Record<string, string> = {
  beginner: 'Beginner',
  elementary: 'Basic',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
  expert: 'Expert',
};
---

<section class={`${className} animate-stagger-in`}>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      Object.entries(groupedSkills).map(([category, categorySkills], categoryIndex) => (
        <div class="card p-6 delay-100">
          {/* Header */}
          <div class="pb-4 mb-4 border-b-2" style="border-color: var(--border);">
            <h3 class="font-display text-xl font-bold uppercase text-[var(--text)]">
              {categoryLabels[category] || category.toUpperCase()}
            </h3>
          </div>

          {/* Skills list */}
          <div class="space-y-3">
            {categorySkills.map((skill) => (
              <div class="flex items-center justify-between">
                <span class="font-body text-base text-[var(--text)]">
                  {skill.name}
                </span>
                <span class="font-body text-xs px-2 py-1 border-2" style="border-color: var(--border); color: var(--accent);">
                  {proficiencyLabels[skill.proficiency] || 'N/A'}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
